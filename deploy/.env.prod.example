# ShuJieTai 生产环境配置模板
# 复制为 deploy/.env.prod 并填值（chmod 600，永不入 git / 任务卡 / 日志）。
# 生成命令：
#   POSTGRES_PASSWORD:  openssl rand -hex 24
#   SHUJIE_JWT_SECRET:  openssl rand -hex 48

# --- PostgreSQL ---
POSTGRES_DB=shujietai
POSTGRES_USER=shujietai
POSTGRES_PASSWORD=

# --- 认证（M1）---
# JWT 签名密钥：固定后重启不掉登录态；缺省则每次重启随机生成、全员掉线
SHUJIE_JWT_SECRET=
# admin 首启种子密码（≥8 位；仅首次建号时读取，之后改密码走 set_password）
SHUJIE_ADMIN_PASSWORD=

# --- 网络 ---
# NAS 宿主机端口：云 nginx proxy_pass 的目标（当前占用 8321=taskdeck、3005=blog、3300/2222=forgejo）
SJT_WEB_PORT=8400
# 同域反代下浏览器不发跨域请求，此项仅作冗余保险
CORS_ORIGINS=https://sjt.guancyxx.cn

# --- 前端构建 ---
# 留空 = 与页面同源（推荐；CORS 问题根治）
VITE_API_BASE_URL=

# --- Hermes OpenAI 兼容桥（可选）---
# 指向 Mac 的 Tailscale 地址（如 http://<mac-100.x>:8642/v1）；留空 = 相关功能不可用但不影响启动
HERMES_API_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=gpt-5.3-codex
